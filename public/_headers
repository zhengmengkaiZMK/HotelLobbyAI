/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/imgs/*
  Cache-Control: public,max-age=31536000,immutable

# Preview mp4s and posters. Workers static assets ignore next.config headers()
# and serve this file instead. Filenames are stable, so this is not immutable.
/templates/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
